---
import { formatLikes, threadFor, type Site } from "../lib/sites";
import SitePreview from "./SitePreview.astro";

interface Props {
  site: Site;
}

const { site } = Astro.props;
const thread = threadFor(site);
---

<a class="card" href={`/s/${site.domain}/`} data-thread={thread.key}>
  <SitePreview site={site} />
  <div class="card-body">
    <p class="domain">{site.domain}</p>
    <p class="tag">{thread.label}</p>
    <p class="byline">
      <span>{site.author}</span>
      <span>{formatLikes(site.likes)}</span>
    </p>
  </div>
</a>
