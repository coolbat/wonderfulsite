---
const path = Astro.url.pathname;
const galleryCurrent = path === "/";
const aboutCurrent = path === "/about" || path.startsWith("/about/");
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/">WonderfulSite</a>
    <nav class="nav" aria-label="Primary">
      <a href="/" aria-current={galleryCurrent ? "page" : undefined}>Gallery</a>
      <a href="/about/" aria-current={aboutCurrent ? "page" : undefined}>About</a>
    </nav>
  </div>
</header>
